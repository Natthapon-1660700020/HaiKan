{
  "name": "haikan-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check:db": "tsx src/checkConnection.ts",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.0",
    "prisma": "6.19.3",
    "tsx": "^4.22.1",
    "typescript": "5.9.3"
  }
}
